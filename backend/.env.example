NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/yugantar_news
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Required only when running the development seed script.
SEED_ADMIN_EMAIL=editor@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-development-password

# Optional article API integrations; never expose these in frontend code.
NEWS_API_KEY=
GNEWS_API_KEY=
